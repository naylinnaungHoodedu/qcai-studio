{
  "package": "qcai-configuration-package",
  "package_version": "1.0.0",
  "schema_version": 1,
  "phase": "2",
  "status": "provisional",
  "created": "2026-11-19",
  "span_identity": {
    "scheme": "span-v2",
    "id_inputs": [
      "scheme",
      "item_id",
      "start",
      "end",
      "content_hash"
    ],
    "item_id_rule": "source_asset_id(filename, kind) | authored-curriculum",
    "canonical_text": "sections-v1",
    "section_separator": "\n\n\n",
    "heading_separator": "\n\n",
    "offset_unit": "unicode-code-point",
    "splitter": {
      "library": "langchain-text-splitters",
      "version": "1.1.2",
      "class": "RecursiveCharacterTextSplitter",
      "chunk_size": 700,
      "chunk_overlap": 120
    },
    "parser": {
      "library": "python-docx",
      "version": "1.2.0",
      "function": "parse_docx_sections"
    }
  },
  "corpus_version": {
    "scheme": "corpus-version-v2",
    "inputs": [
      "item_id",
      "version",
      "sha256",
      "plane",
      "bound",
      "span_scheme"
    ]
  },
  "gates": {
    "p1-floor": {
      "version": "score-floor-p1-v1",
      "floor": 6,
      "authority": "P1-D-04",
      "stopwords": "retrieval_p1.QUERY_STOPWORDS (178 words, frozen)",
      "scope": "containment for the D-31 configuration; see Phase 2 spec conflict 29"
    },
    "bm25f-v1": {
      "see": "retrieval, abstention"
    }
  },
  "retrieval": {
    "algorithm": "bm25f-simple-v1",
    "k1": 1.5,
    "b": 0.75,
    "title_weight": 2.0,
    "idf": "ln(1+(N-df+0.5)/(df+0.5))",
    "tokenizer": {
      "version": "nfkc-casefold-alnum-v1",
      "min_token_length": 2,
      "stemmer": "none"
    },
    "stopwords": {
      "version": "stopwords-v1",
