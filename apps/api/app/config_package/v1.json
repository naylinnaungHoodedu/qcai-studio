    "coverage_rule": "coverage-v1",
    "tie_break": "span_id ascending",
    "module_boost": false,
    "chapter_summaries_indexed": false
  },
  "semantic": {
    "enabled_by_default": false,
    "vector_id_scheme": "span-v2",
    "require_namespace_count_equals_span_count": true,
    "apply_active_gate_to_every_result": true
  },
  "abstention": {
    "version": "abstention-p2-v1",
    "floor": 2.35,
    "margin": 2.4,
    "provisional": true,
    "provisional_until": "Phase 4",
    "not_final_before": "E1 freeze",
    "calibration_record": "docs/evaluation/phase2/calibration_record_v1.json",
    "calibration_record_sha256": "ab8aca0d58c9ea201773fcf11972d45a6fb57a29d64b91921bf40a72e755d7e9"
  },
  "near_duplicate": {
    "version": "near-dup-v1",
    "provisional": true,
    "document_shingle_words": 5,
    "document_jaccard_threshold": 0.5,
    "document_containment_threshold": 0.8,
    "video_duration_tolerance_s": 0.5,
    "video_size_ratio_tolerance": 0.01,
    "chapter_shingle_words": 5,
    "chapter_jaccard_threshold": 0.5
  },
  "legacy_citations": {
    "decision": "D-30",
    "status": "provisional",
    "ratified": false,
    "match_rule": "unique normalised-excerpt hash (D3); titles, containment and v1 content_hash are diagnostics",
    "max_unresolved_share_native": 0.0,
    "max_unresolved_share_legacy": null,
    "legacy_share_statistic": "point",
    "legacy_share_statistic_note": "used only when max_unresolved_share_legacy is a number: 'point' compares the observed share (the plan's \"unresolved citations exceed the threshold\"), 'wilson95_upper' its Wilson 95% upper bound; D-30 ratifies both",
    "stop_on_exact_match_regression": true,
    "stop_on_non_canonical_row_in_apply": true,
    "unresolved_label": "unverified historical reference",
    "dual_read_releases": 2
  },
  "owner_decisions": {
    "D-17": {
      "option": "a",
      "text": "interim, migrate by Phase 11",
      "status": "provisional",
      "authority": "P1-D-18 (owner delegation, 2026-11-19)",
      "ratified": false,
      "record": "docs/adr/ADR-002-retrieval-architecture.md (Revision 2026-11-19)"
    },
    "D-30": {
      "status": "provisional",
      "authority": "P1-D-18",
      "ratified": false,
      "rule": "pre-Phase-2 citations that cannot be resolved are labelled legacy_unresolved and never presented as resolved; the migration report shows their share; citations created by the Phase 2 pipeline must resolve 100%"
    },
    "Q-10": {
      "state": "unresolved",
      "path": "2025 asset only (plan Action 25 stop condition)",
      "unbound_items": [
        {
          "item_id": "quantum-computing-and-artificial-intelligence-2026",
          "asset_filename": "Quantum Computing and Artificial Intelligence 2026.mp4"
        }
      ]
    },
    "PLAN-11.3": {
      "status": "provisional",
      "ratified": false,
      "authority": "P1-D-18 (engineering default); ratification needs the Principal Investigator or the Research Lead",
      "deviations": [
        {
          "plan": "11.3: \"a stemmed, stopword-filtered BM25-style index\"",
          "applied": "retrieval.tokenizer.stemmer = none (an S-stemmer raised out-of-scope leakage, all-approved maximum 8.2); spec conflict 5"
        },
        {
          "plan": "11.3: \"a sufficiency gate (floor plus runner-up margin) before any generator call\"",
          "applied": "the margin labels near_floor results (floor <= score < floor + margin, D6 and V1.5) and drops none; no runner-up test (spec conflict 4; Phase 4, DI-28)"
        }
      ],
      "record": "docs/adr/ADR-002-retrieval-architecture.md (Revision 2026-11-19)"
    }
  },
  "boundary": {
    "version": "boundary-v1",
    "private_plane_globs": [
      "corpus/private/**",
      "lqs/private/**",
      "lqs/ratings/*.private.jsonl",
      "docs/thesis/ethics/private/**",
      "evaluation/reports/*.private.json",
      "**/*.private.json",
      "**/*.private.jsonl"
    ],
    "public_exceptions": [
      "corpus/private/README.md"
    ],
    "licensed_volume_globs": [
      "**/*.pdf"
    ],
    "secret_like_name_globs": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/*.env",
      "**/*.env.yaml",
      "**/*.env.local"
    ],
    "passage_shingle_words": 12,
    "passage_min_hits_per_file": 1
  }
