    "enabled_by_default": false,
    "vector_id_scheme": "span-v2",
    "require_namespace_count_equals_span_count": true,
    "apply_active_gate_to_every_result": true
  },
  "abstention": {
    "version": "abstention-p2-v1",
    "floor": 2.35,
    "margin": 2.4,
    "provisional": true,
    "provisional_until": "Phase 4",
    "not_final_before": "E1 freeze",
    "calibration_record": "docs/evaluation/phase2/calibration_record_v1.json",
    "calibration_record_sha256": "cf9902d437df23e342dee7640242f31efe7c40d6ff2c51972be24d2dc87c572c"
  },
  "near_duplicate": {
    "version": "near-dup-v1",
    "provisional": true,
    "document_shingle_words": 5,
    "document_jaccard_threshold": 0.5,
    "document_containment_threshold": 0.8,
    "video_duration_tolerance_s": 0.5,
    "video_size_ratio_tolerance": 0.01,
    "chapter_shingle_words": 5,
    "chapter_jaccard_threshold": 0.5
  },
  "legacy_citations": {
    "decision": "D-30",
    "status": "provisional",
    "ratified": false,
    "match_rule": "unique normalised-excerpt hash (D3); titles, containment and v1 content_hash are diagnostics",
    "max_unresolved_share_native": 0.0,
    "max_unresolved_share_legacy": null,
    "stop_on_exact_match_regression": true,
    "stop_on_non_canonical_row_in_apply": true,
    "unresolved_label": "unverified historical reference",
    "dual_read_releases": 2
  },
  "owner_decisions": {
    "D-17": {
      "option": "a",
      "text": "interim, migrate by Phase 11",
      "status": "provisional",
      "authority": "P1-D-18 (owner delegation, 2026-11-19)",
      "ratified": false,
      "record": "docs/adr/ADR-002-retrieval-architecture.md (Revision 2026-11-19)"
    },
    "D-30": {
      "status": "provisional",
      "authority": "P1-D-18",
      "ratified": false,
      "rule": "pre-Phase-2 citations that cannot be resolved are labelled legacy_unresolved and never presented as resolved; the migration report shows their share; citations created by the Phase 2 pipeline must resolve 100%"
    },
    "Q-10": {
      "state": "unresolved",
      "path": "2025 asset only (plan Action 25 stop condition)",
      "unbound_items": [
        {
          "item_id": "quantum-computing-and-artificial-intelligence-2026",
          "asset_filename": "Quantum Computing and Artificial Intelligence 2026.mp4"
        }
      ]
    }
  },
  "boundary": {
    "version": "boundary-v1",
    "private_plane_globs": [
      "corpus/private/**",
      "lqs/private/**",
      "lqs/ratings/*.private.jsonl",
      "docs/thesis/ethics/private/**",
      "evaluation/reports/*.private.json",
      "**/*.private.json",
      "**/*.private.jsonl"
    ],
    "public_exceptions": [
      "corpus/private/README.md"
    ],
    "licensed_volume_globs": [
      "**/*.pdf"
    ],
    "secret_like_name_globs": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/*.env",
      "**/*.env.yaml",
      "**/*.env.local"
    ],
