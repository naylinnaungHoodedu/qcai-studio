          "type": "string"
        },
        "near_floor": {
          "title": "Near Floor",
          "type": "boolean"
        },
        "quotable": {
          "title": "Quotable",
          "type": "boolean"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "span_id": {
          "pattern": "^span-[0-9a-f]{64}$",
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "item_id",
        "item_version",
        "kind",
        "char_start",
        "char_end",
        "content_hash",
        "score",
        "near_floor",
        "license_class",
        "quotable"
      ],
