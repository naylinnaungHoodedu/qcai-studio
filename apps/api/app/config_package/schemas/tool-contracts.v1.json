{
  "contract_version": "mcp-tools-v1",
  "servers": {
    "analytics": {
      "analytics.record_outcome": {
        "input": {
          "additionalProperties": false,
          "properties": {
            "calls": {
              "minimum": 0,
              "title": "Calls",
              "type": "integer"
            },
            "cost_units": {
              "minimum": 0,
              "title": "Cost Units",
              "type": "integer"
            },
            "degraded_mode": {
              "enum": [
                "FULL",
                "REDUCED-2",
                "REDUCED-1",
                "ZERO"
              ],
              "title": "Degraded Mode",
              "type": "string"
            },
            "final": {
              "enum": [
                "deliver",
                "withhold",
                "abstain"
              ],
              "title": "Final",
              "type": "string"
            },
            "surface": {
              "const": "two_pass",
              "default": "two_pass",
              "title": "Surface",
              "type": "string"
            }
          },
          "required": [
            "final",
            "degraded_mode",
            "calls",
            "cost_units"
          ],
          "title": "OutcomeEvent",
          "type": "object"
        },
        "output": {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true,
              "default": true,
              "title": "Ok",
              "type": "boolean"
            }
          },
          "title": "Ack",
          "type": "object"
        },
        "roles": [
          "ledger"
        ]
      }
    },
    "citation": {
      "citation.resolve": {
        "input": {
          "additionalProperties": false,
          "properties": {
            "span_id": {
              "pattern": "^span-[0-9a-f]{64}$",
              "title": "Span Id",
              "type": "string"
            }
          },
          "required": [
            "span_id"
          ],
          "title": "SpanRef",
          "type": "object"
        },
        "output": {
          "additionalProperties": false,
          "properties": {
            "content_hash": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Content Hash"
            },
            "item_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Item Id"
            },
            "resolution": {
              "enum": [
                "resolved",
                "unresolvable"
              ],
              "title": "Resolution",
              "type": "string"
            },
            "span_id": {
              "title": "Span Id",
              "type": "string"
            }
          },
          "required": [
            "span_id",
            "resolution"
          ],
          "title": "SpanResolution",
          "type": "object"
        },
        "roles": [
          "evidential",
          "pedagogical",
          "verifier"
        ]
      }
    },
    "corpus": {
      "corpus.retrieve": {
        "input": {
          "additionalProperties": false,
          "description": "Plan 3.2: exactly the resolved text, the lesson scope and the corpus version; no learner field (R-41).",
          "properties": {
            "corpus_version": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Corpus Version",
              "type": "string"
            },
            "lesson_slug": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Lesson Slug"
            },
            "text": {
              "maxLength": 4001,
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text",
            "corpus_version"
          ],
          "title": "RetrievalRequest",
          "type": "object"
        },
        "output": {
          "$defs": {
            "EvidenceSpan": {
              "additionalProperties": false,
              "properties": {
                "char_end": {
                  "minimum": 1,
                  "title": "Char End",
                  "type": "integer"
                },
                "char_start": {
                  "minimum": 0,
                  "title": "Char Start",
                  "type": "integer"
                },
                "content_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Content Hash",
                  "type": "string"
                },
                "item_id": {
                  "title": "Item Id",
                  "type": "string"
                },
                "item_version": {
                  "title": "Item Version",
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "document",
                    "authored"
                  ],
                  "title": "Kind",
                  "type": "string"
                },
                "license_class": {
                  "const": "public",
                  "title": "License Class",
                  "type": "string"
                },
                "near_floor": {
                  "title": "Near Floor",
                  "type": "boolean"
                },
                "quotable": {
                  "title": "Quotable",
                  "type": "boolean"
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Score"
                },
                "span_id": {
                  "pattern": "^span-[0-9a-f]{64}$",
                  "title": "Span Id",
                  "type": "string"
                }
              },
              "required": [
                "span_id",
                "item_id",
                "item_version",
                "kind",
                "char_start",
                "char_end",
                "content_hash",
                "score",
                "near_floor",
                "license_class",
                "quotable"
              ],
              "title": "EvidenceSpan",
              "type": "object"
            },
            "Sufficiency": {
              "additionalProperties": false,
              "properties": {
                "decision": {
                  "enum": [
                    "answer",
                    "abstain",
                    "near_miss"
                  ],
                  "title": "Decision",
                  "type": "string"
                },
                "floor": {
                  "title": "Floor",
                  "type": "number"
                },
                "gate": {
                  "enum": [
                    "p1-floor",
                    "bm25f-v1"
                  ],
                  "title": "Gate",
                  "type": "string"
                },
                "margin": {
                  "title": "Margin",
                  "type": "number"
                },
                "reason": {
                  "title": "Reason",
                  "type": "string"
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Score"
                },
                "threshold_version": {
                  "title": "Threshold Version",
                  "type": "string"
                }
              },
              "required": [
                "score",
                "gate",
                "threshold_version",
                "floor",
                "margin",
                "decision",
                "reason"
              ],
              "title": "Sufficiency",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "bundle_schema": {
              "const": "evidence-bundle-v1",
              "default": "evidence-bundle-v1",
              "title": "Bundle Schema",
              "type": "string"
            },
            "conflicts": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Conflicts",
              "type": "array"
            },
            "corpus_version": {
              "title": "Corpus Version",
              "type": "string"
            },
            "index_version": {
              "title": "Index Version",
              "type": "string"
            },
            "retrieval_mode": {
              "const": "lexical",
              "title": "Retrieval Mode",
              "type": "string"
            },
            "spans": {
              "items": {
                "$ref": "#/$defs/EvidenceSpan"
              },
              "maxItems": 12,
              "title": "Spans",
              "type": "array"
            },
            "sufficiency": {
              "$ref": "#/$defs/Sufficiency"
            }
          },
          "required": [
            "corpus_version",
            "index_version",
            "retrieval_mode",
            "spans",
            "sufficiency"
          ],
          "title": "EvidenceBundle",
          "type": "object"
        },
        "roles": [
          "evidential"
        ]
      },
      "corpus.span_text": {
        "input": {
          "additionalProperties": false,
          "properties": {
            "span_id": {
              "pattern": "^span-[0-9a-f]{64}$",
              "title": "Span Id",
              "type": "string"
            }
          },
          "required": [
            "span_id"
          ],
          "title": "SpanRef",
          "type": "object"
        },
        "output": {
          "additionalProperties": false,
          "properties": {
            "content_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Content Hash",
              "type": "string"
            },
            "plane": {
              "const": "public",
              "title": "Plane",
              "type": "string"
            },
            "span_id": {
              "pattern": "^span-[0-9a-f]{64}$",
              "title": "Span Id",
              "type": "string"
            },
            "text": {
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "span_id",
            "text",
            "content_hash",
            "plane"
          ],
          "title": "SpanText",
          "type": "object"
        },
        "roles": [
          "evidential",
          "verifier"
        ]
      }
    },
    "learner": {
      "learner.presentation_plan": {
        "input": {
          "additionalProperties": false,
          "properties": {
            "hint": {
              "anyOf": [
                {
                  "enum": [
                    "concise",
                    "stepwise",
                    "socratic"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Hint"
            }
          },
          "title": "PresentationRequest",
          "type": "object"
        },
        "output": {
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "enum": [
                "concise",
                "stepwise",
                "socratic"
              ],
              "title": "Plan Id",
              "type": "string"
            },
            "source": {
              "enum": [
                "request",
                "default"
              ],
              "title": "Source",
              "type": "string"
            }
          },
          "required": [
            "plan_id",
            "source"
          ],
          "title": "PresentationPlan",
          "type": "object"
        },
        "roles": [
          "pedagogical",
          "planner"
        ]
      }
    },
    "verification": {
      "verification.alignment": {
        "input": {
          "$defs": {
            "AlignmentInstructions": {
              "additionalProperties": false,
              "properties": {
                "prompt_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Prompt Hash",
                  "type": "string"
                },
                "prompt_id": {
                  "const": "alignment-item-v1",
                  "default": "alignment-item-v1",
                  "title": "Prompt Id",
                  "type": "string"
                },
                "ratings": {
                  "default": [
                    1,
                    2,
                    3,
                    4,
                    5
                  ],
                  "items": {
                    "type": "integer"
                  },
                  "title": "Ratings",
                  "type": "array"
                },
                "tool_contract_version": {
                  "title": "Tool Contract Version",
                  "type": "string"
                }
              },
              "required": [
                "prompt_hash",
                "tool_contract_version"
              ],
              "title": "AlignmentInstructions",
              "type": "object"
            },
            "ReadabilityBand": {
              "additionalProperties": false,
              "properties": {
                "max_grade": {
                  "title": "Max Grade",
                  "type": "number"
                },
                "min_grade": {
                  "title": "Min Grade",
                  "type": "number"
                }
              },
              "required": [
                "min_grade",
                "max_grade"
              ],
              "title": "ReadabilityBand",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "band": {
              "$ref": "#/$defs/ReadabilityBand"
            },
            "instructions": {
              "$ref": "#/$defs/AlignmentInstructions"
            },
            "item": {
              "const": "alignment",
              "default": "alignment",
              "title": "Item",
              "type": "string"
            },
            "objective": {
              "anyOf": [
                {
                  "maxLength": 4000,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Objective"
            },
            "rendered_text": {
              "maxLength": 20000,
              "minLength": 1,
              "title": "Rendered Text",
              "type": "string"
            },
            "request_schema": {
              "const": "v2-alignment-request-v1",
              "default": "v2-alignment-request-v1",
              "title": "Request Schema",
              "type": "string"
            }
          },
          "required": [
            "rendered_text",
            "band",
            "instructions"
          ],
          "title": "AlignmentRequest",
          "type": "object"
        },
        "output": {
          "additionalProperties": false,
          "properties": {
            "leakage": {
              "title": "Leakage",
              "type": "boolean"
            },
            "rating": {
              "maximum": 5,
              "minimum": 1,
              "title": "Rating",
              "type": "integer"
            }
          },
          "required": [
            "rating",
            "leakage"
          ],
          "title": "AlignmentVerdict",
          "type": "object"
        },
        "roles": [
          "verifier"
        ]
      },
      "verification.verdict": {
        "input": {
          "$defs": {
            "VerdictInstructions": {
              "additionalProperties": false,
              "properties": {
                "ehmf_types": {
                  "default": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E"
                  ],
                  "items": {
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "D",
                      "E"
                    ],
                    "type": "string"
                  },
                  "title": "Ehmf Types",
                  "type": "array"
                },
                "prompt_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Prompt Hash",
                  "type": "string"
                },
                "prompt_id": {
                  "const": "blind-claim-span-v1",
                  "default": "blind-claim-span-v1",
                  "title": "Prompt Id",
                  "type": "string"
                },
                "tool_contract_version": {
                  "title": "Tool Contract Version",
                  "type": "string"
                },
                "verdicts": {
                  "default": [
                    "SUPPORTED",
                    "CONTRADICTED",
                    "NOT_ENOUGH_INFO"
                  ],
                  "items": {
                    "enum": [
                      "SUPPORTED",
                      "CONTRADICTED",
                      "NOT_ENOUGH_INFO"
                    ],
                    "type": "string"
                  },
                  "title": "Verdicts",
                  "type": "array"
                }
              },
              "required": [
                "prompt_hash",
                "tool_contract_version"
              ],
              "title": "VerdictInstructions",
              "type": "object"
            },
            "VerdictSpan": {
              "additionalProperties": false,
              "properties": {
                "span_id": {
                  "pattern": "^span-[0-9a-f]{64}$",
                  "title": "Span Id",
                  "type": "string"
                },
                "text": {
                  "maxLength": 20000,
                  "minLength": 1,
                  "title": "Text",
                  "type": "string"
                }
              },
              "required": [
                "span_id",
                "text"
              ],
              "title": "VerdictSpan",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "claim_text": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Claim Text",
              "type": "string"
            },
            "instructions": {
              "$ref": "#/$defs/VerdictInstructions"
            },
            "item": {
              "const": "claim",
              "default": "claim",
              "title": "Item",
              "type": "string"
            },
            "request_schema": {
              "const": "v2-verdict-request-v1",
              "default": "v2-verdict-request-v1",
              "title": "Request Schema",
              "type": "string"
            },
            "span": {
              "$ref": "#/$defs/VerdictSpan"
            }
          },
          "required": [
            "claim_text",
            "span",
            "instructions"
          ],
          "title": "VerdictRequest",
          "type": "object"
        },
        "output": {
          "additionalProperties": false,
          "properties": {
            "ehmf_type": {
              "anyOf": [
                {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ehmf Type"
            },
            "span_id": {
              "pattern": "^span-[0-9a-f]{64}$",
              "title": "Span Id",
              "type": "string"
            },
            "verdict": {
              "enum": [
                "SUPPORTED",
                "CONTRADICTED",
                "NOT_ENOUGH_INFO"
              ],
              "title": "Verdict",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "ehmf_type",
            "span_id"
          ],
          "title": "AdapterVerdict",
          "type": "object"
        },
        "roles": [
          "verifier"
        ]
      }
    }
  },
  "transport": "in-process"
}
