{
  "$defs": {
    "BudgetStamp": {
      "additionalProperties": false,
      "description": "The budgets in force for this record (PD-11). They are package values unless TWO_PASS_SHADOW_BUDGET_MS or\nTUTOR_LEDGER_APPEND_BUDGET_MS overrode them, so config_package_sha256 alone does not name them when\n`overridden` is not empty (R-46). shadow_ms is null where no shadow budget applies (a legacy record, an\nunbounded replay run).",
      "properties": {
        "ledger_append_ms": {
          "minimum": 1,
          "title": "Ledger Append Ms",
          "type": "integer"
        },
        "overridden": {
          "default": [],
          "items": {
            "enum": [
              "shadow_ms",
              "ledger_append_ms"
            ],
            "type": "string"
          },
          "title": "Overridden",
          "type": "array"
        },
        "shadow_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shadow Ms"
        }
      },
      "required": [
        "shadow_ms",
        "ledger_append_ms"
      ],
      "title": "BudgetStamp",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "check_id": {
          "enum": [
            "V1.1",
            "V1.2",
            "V1.3",
            "V1.4",
            "V1.5",
            "V1.6",
            "V1.7",
            "V1.8",
            "V1.9"
          ],
          "title": "Check Id",
          "type": "string"
        },
        "checker_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checker Model Id"
        },
        "claim_id": {
          "anyOf": [
            {
              "pattern": "^claim-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "ehmf_types": {
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ],
            "type": "string"
          },
          "title": "Ehmf Types",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "pass",
            "flag",
            "hard_fail",
            "abstain",
            "mark"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "stage": {
          "enum": [
            "pre_render",
            "post_render"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "stage",
        "attempt",
        "outcome",
        "ehmf_types",
        "reason_code"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "ClaimLedgerEntryV2": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^claim-[0-9a-f]{32}$",
          "title": "Claim Id",
          "type": "string"
        },
        "entailment_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entailment Score"
        },
        "locked": {
          "const": true,
          "default": true,
          "title": "Locked",
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceV2"
        },
        "response_id": {
          "pattern": "^(turn|shadow|qa)-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Response Id",
          "type": "string"
        },
        "span_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Span Ids",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "response_id",
        "text",
        "span_ids",
        "provenance"
      ],
      "title": "ClaimLedgerEntryV2",
      "type": "object"
    },
    "ClaimVerdict": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^claim-[0-9a-f]{32}$",
          "title": "Claim Id",
          "type": "string"
        },
        "cycle_count": {
          "maximum": 4,
          "minimum": 0,
          "title": "Cycle Count",
          "type": "integer"
        },
        "final": {
          "enum": [
            "deliver",
            "correct",
            "withhold",
            "abstain"
          ],
          "title": "Final",
          "type": "string"
        },
        "v1": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "V1",
          "type": "array"
        },
        "v2": {
          "default": null,
          "title": "V2",
          "type": "null"
        },
        "v3": {
          "anyOf": [
            {
              "$ref": "#/$defs/V3Intent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "claim_id",
        "v1",
        "final",
        "cycle_count"
      ],
      "title": "ClaimVerdict",
      "type": "object"
    },
    "ConflictPair": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "item_ids": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
