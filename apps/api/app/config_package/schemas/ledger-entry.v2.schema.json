          "type": "string"
        },
        "span_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Span Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "span_ids",
        "item_ids"
      ],
      "title": "ConflictPair",
      "type": "object"
    },
    "DisclosureBlock": {
      "additionalProperties": false,
      "properties": {
        "block_schema": {
          "const": "conflict-disclosure-v1",
          "default": "conflict-disclosure-v1",
          "title": "Block Schema",
          "type": "string"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/ConflictPair"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Conflicts",
          "type": "array"
        },
        "policy": {
          "enum": [
            "disclose",
            "withhold"
          ],
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "conflicts"
      ],
      "title": "DisclosureBlock",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "minimum": 1,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "item_version": {
          "title": "Item Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "document",
            "authored"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license_class": {
          "const": "public",
